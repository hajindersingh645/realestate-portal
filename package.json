{
  "name": "hanu-property",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "lint": "eslint . --no-error-on-unmatched-pattern && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck",
    "test": "vitest run --passWithNoTests",
    "test:int": "vitest run --config vitest.int.config.ts --passWithNoTests",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "dev": "pnpm -r --parallel dev",
    "migrate": "pnpm -r migrate",
    "gen:keys": "tsx scripts/gen-dev-keys.ts",
    "dev:token": "tsx --env-file=.env scripts/dev-token.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-security": "^4.2.0",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
