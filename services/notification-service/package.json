{
  "name": "notification-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --env-file=.env src/server.ts",
    "migrate": "tsx --env-file=../../.env --env-file=.env src/migrate.ts",
    "migration:create": "MIKRO_ORM_CLI_TS_CONFIG_PATH=../../tsconfig.json node --env-file=../../.env --env-file=.env node_modules/@mikro-orm/cli/cli.js migration:create --config ./mikro-orm.config.ts"
  },
  "dependencies": {
    "@hanu/contracts": "workspace:*",
    "@hanu/service-kit": "workspace:*",
    "@mikro-orm/core": "7.2.4",
    "@mikro-orm/decorators": "7.2.4",
    "@mikro-orm/migrations": "7.2.4",
    "@mikro-orm/postgresql": "7.2.4",
    "fastify": "^5.12.8",
    "typebox": "^1.3.36"
  },
  "devDependencies": {
    "@mikro-orm/cli": "7.2.4"
  }
}
