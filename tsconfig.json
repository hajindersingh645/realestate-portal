{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src",
    "services/*/src",
    "services/*/migrations",
    "services/*/mikro-orm.config.ts",
    "scripts",
    "*.config.ts",
    "vitest.swc.ts",
    "vitest.int.global-setup.ts"
  ],
  "exclude": ["packages/web-kit"]
}
